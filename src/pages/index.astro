---
import Layout from "@layouts/Index.astro";
import Description from "@components/main/Description.astro";
import Image from "@components/sidebar/Image.astro";
import Info from "@components/sidebar/Info.astro";
import Stats from "@components/sidebar/Stats.astro";
import Orgs from "@components/main/Orgs.astro";
import Project from "@components/main/Project.astro";
import { projects, teams, welcome } from "@data";
---

<Layout Title="Home">
    <div class="mx-[10vw] my-[8vw]">
        <div class="lg:flex space-x-10 space-y-10">
            <div class="grid grid-cols-1 p-2 space-y-2 w-full max-w-fit">
                <Image />
                <div>
                    <Info />
                    <Stats />
                </div>
            </div>
            <div class="space-y-5">
                <Description text={welcome} />
                <div class="flex justify-center items-center sm:block">
                    <div class="space-y-5">
                        <div class="space-y-3">
                            <h1>Associated Organisations and Teams</h1>
                            <div class="flex space-x-2">
                                <div class="grid grid-cols-2 sm:grid-cols-2 h-full gap-2 w-fit">
                                    {teams.map((team) => <Orgs ImageUri={team.ImageUri} Text={team.Text} TextLink={team.TextLink} />)}
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <h1>Projects</h1>
                            <div class="flex max-w-fit">
                                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 h-full w-full gap-4">
                                    {
                                        projects.map((project) => (
                                            <Project
                                                Discontinued={project.Discontinued}
                                                URL={project.URL}
                                                Title={project.Title}
                                                Description={project.Description}
                                            />
                                        ))
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
