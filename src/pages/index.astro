---
import Layout from "@layouts/Index.astro";
import Description from "@components/main/Description.astro";
import Image from "@components/sidebar/Image.astro";
import Info from "@components/sidebar/Info.astro";
import Stats from "@components/sidebar/Stats.astro";
import Orgs from "@components/main/Orgs.astro";
import Project from "@components/main/Project.astro";
import { projects, teams, welcome } from "@data";
---

<Layout Title="Home">
  <div
    class="mx-10 xl:mx-40 2xl:mx-60 my-20 md:my-36 transition-all duration-75 ease-in-out delay-0"
  >
    <div
      class="grid space-y-4 grid-cols-1 md:grid-cols-[19rem,20rem] lg:grid-cols-[19rem,40rem] xl:grid-cols-[19rem,60rem] 2xl:grid-cols-[19rem,80rem] w-full space-x-3"
    >
      <div class="p-2 space-y-2">
        <Image />
        <Info />
        <Stats />
      </div>
      <div class="space-y-5">
        <Description text={welcome} />
        <div class="space-y-3">
          <h1>Associated Organisations and Teams</h1>
          <div class="flex space-x-2">
            <div
              class="grid auto-cols-max grid-cols-2 sm:grid-cols-3 md:grid-cols-[auto,auto,auto,auto] lg:grid-cols-[auto,auto,auto,auto,auto] h-full gap-2 w-fit"
            >
              {
                teams.map((team) => (
                  <Orgs
                    ImageUri={team.ImageUri}
                    Text={team.Text}
                    TextLink={team.TextLink}
                  />
                ))
              }
            </div>
          </div>
        </div>
        <div class="space-y-3">
          <h1>Projects</h1>
          <div class="flex w-full">
            <div
              class="grid auto-cols-max grid-cols-1 md:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 h-full w-full gap-4"
            >
              {
                projects.map((project) => (
                  <Project
                    Discontinued={project.Discontinued}
                    URL={project.URL}
                    Title={project.Title}
                    Description={project.Description}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
