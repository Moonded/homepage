---
import Layout from "@layouts/Blog.astro";
import BlogPost from "@components/blog/BlogPost.astro";
const posts = await Astro.glob("./*.md");
---

<Layout>
  {
    posts.map((post) => (
      <BlogPost
        url={post.url}
        title={post.frontmatter.title}
        pubDate={post.frontmatter.pubDate}
      />
    ))
  }
</Layout>
