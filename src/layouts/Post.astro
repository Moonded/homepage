---
const { frontmatter } = Astro.props;
import FormattedDate from "@components/blog/FormattedDate.astro";
import "@styles/blog.scss";
import "@styles/style.scss";
import Breadcrump from "@components/global/Breadcrump.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title}</title>
  </head>
  <body class="bg-neutral-950 text-white flex justify-center">
    <div class="w-8/12 my-20">
        <div class="mb-5 space-y-2">
          <Breadcrump/>
            <h1 class="text-4xl font-bold">{frontmatter.title}</h1>
            <div>
                <span class="font-bold">Published</span><FormattedDate
                    date={frontmatter.pubDate}
                />
            </div>
            </div>
        <slot />
    </div>  
  </body>
</html>
