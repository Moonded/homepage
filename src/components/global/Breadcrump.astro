---
const data = Astro.url;
const breadcrumbs = data.pathname.split('/').filter((crumb) => crumb !== '');
---
<div>
    <nav class="text-neutral-400 font-bold text-sm">
        <ul class="flex space-x-2">
        <a href="/">Home</a>
        {
            breadcrumbs.map((crumb, index) => (
            <span> &gt;</span><a href={`/${crumb}`}>{crumb.charAt(0).toUpperCase() + crumb.slice(1)}</a>
            ))
        }
        </ul>
    </nav>
</div>