---
import { isClassStaticBlockDeclaration } from 'typescript';

interface Props {
  date: Date;
  classes?: string;
}

const { date, classes } = Astro.props;
const pubDate = new Date(date);
---

<time datetime={pubDate.toISOString()} class={classes}>
  {
    pubDate
      .toLocaleDateString("en-uk", {
        year: "numeric",
        month: "numeric",
        day: "numeric",
      })
      .replace(/\//g, "-")
  }
</time>
