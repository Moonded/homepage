---
const { text } = Astro.props;
---

<div class="rounded-lg bg-linear-to-r from-pink-500 via-red-500 to-yellow-500 p-px max-w-6xl">
    <div class="bg-neutral-950 rounded-lg">
        <div class="p-5 rounded-lg space-y-5">
            <p class="text-xs">
                Moonded <span class="text-neutral-400">/</span> Welcome<span class="text-neutral-400">.txt</span>
            </p>
            <h1 class="text-2xl font-bold">Hi, I'm Sebastian! 👋</h1>
            <hr style="margin-top: .5rem !important" class="border-neutral-500" />
            <p class="text-sm">{text}</p>
        </div>
    </div>
</div>
