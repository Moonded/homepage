---
const { Title, URL, Description, Discontinued } = Astro.props;
---

<div class="rounded-lg bg-white hover:bg-linear-to-r hover:from-pink-500 hover:via-red-500 hover:to-yellow-500 p-px w-full max-w-80 overflow-hidden">
    <div class="bg-neutral-950 rounded-lg w-full px-2 py-2 hover:bg-neutral-900 h-full">
        <a href={URL} class="grid grid-rows-[2rem,auto,2rem] text-neutral-100 hover:text-white transition-colors duration-200 h-full">
            <h3 class="text-lg font-semibold">
                {Title}
                {Discontinued ? " - Discontinued" : ""}
            </h3>
            <p class="text-sm text-neutral-300 text-clip flex items-center text-wrap">
                {Description}
            </p>
            <div class="flex items-center overflox-hidden text-nowrap">
                <svg
                    class="w-4 h-4 text-neutral-300 mr-1"
                    xmlns="http://w3.org"
                    viewBox="0 0 24 24"
                    width="64"
                    height="64"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>

                <span class="text-sm text-neutral-300">{URL}</span>
            </div>
        </a>
    </div>
</div>
