---
const { ImageUri, Text, TextLink } = Astro.props;
import { Image } from "astro:assets";
---

<div class="rounded-lg bg-white hover:bg-linear-to-r hover:from-pink-500 hover:via-red-500 hover:to-yellow-500 p-px w-max max-w-80">
    <div class="bg-neutral-950 rounded-lg w-fit px-2 py-1 hover:bg-neutral-900 h-full">
        <a class="flex items-center justify-center space-x-1 text-sm" href={TextLink}>
            <Image
                src={ImageUri}
                alt="Org"
                class="inline text-center border rounded border-neutral-500 h-fit bg-neutral-950"
                width="20"
                height="20"
                loading="eager"
            />
            <p class="inline">{Text}</p></a
        >
    </div>
</div>
