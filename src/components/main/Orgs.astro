---
const { ImageUri, Text, TextLink } = Astro.props;
---

<div
  class="rounded-lg bg-white hover:bg-gradient-to-r hover:from-pink-500 hover:via-red-500 hover:to-yellow-500 p-[1px] w-max max-w-80"
>
  <div
    class="bg-neutral-950 rounded-lg w-fit px-2 py-1 hover:bg-neutral-900 h-full"
  >
    <a
      class="flex items-center justify-center space-x-1 text-sm"
      href={TextLink}
    >
      <img
        src={ImageUri}
        alt="Profile Picture"
        class="inline text-center border rounded border-neutral-500 h-fit bg-neutral-950"
        width="20"
        height="20"
      />
      <p class="inline">{Text}</p></a
    >
  </div>
</div>
