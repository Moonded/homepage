{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    "paths": {
      "@layouts/*": ["layouts/*"],
      "@pages/*": ["pages/*"],
      "@components/*": ["components/*"],
      "@content/*": ["content/*"],
      "@styles/*": ["styles/*"],
      "@data": ["data"]
    }
  }
}
